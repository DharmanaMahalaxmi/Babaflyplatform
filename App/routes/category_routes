from typing import List
from fastapi import APIRouter, Depends, status
from sqlalchemy.orm import Session
from app.config.database import get_db
from app.models.user import User
from app.schemas.category import CategoryOut, CategoryCreate
from app.schemas.product import ProductOut
from app.controllers.category_controller import CategoryController
from app.utils.security import get_current_admin

router = APIRouter(prefix="/categories", tags=["Categories"])

@router.get("", response_model=List[CategoryOut], summary="List all product categories")
def list_categories(db: Session = Depends(get_db)):
    """
    Retrieve all available product categories (e.g., Rings, Necklaces, Bracelets, Earrings).
    """
    return CategoryController.get_all(db=db)

@router.get("/{id}/products", response_model=List[ProductOut], summary="Get all products in a specific category")
def get_products_by_category(id: int, db: Session = Depends(get_db)):
    """
    Retrieve all products matching the specified category ID.
    """
    return CategoryController.get_products_by_category(db=db, category_id=id)

@router.post("", response_model=CategoryOut, status_code=status.HTTP_201_CREATED, summary="Create category (Admin Only)")
def create_category(
    data: CategoryCreate,
    admin: User = Depends(get_current_admin),
    db: Session = Depends(get_db)
):
    """
    Admin only: Create a new category entry.
    """
    return CategoryController.create(db=db, data=data)
