from sqlalchemy.orm import Session
from fastapi import HTTPException, status
from app.models.category import Category
from app.models.product import Product
from app.schemas.category import CategoryCreate
from app.utils.logger import logger

class CategoryService:
    @staticmethod
    def get_all(db: Session):
        return db.query(Category).all()

    @staticmethod
    def get_by_id(db: Session, category_id: int):
        category = db.query(Category).filter(Category.id == category_id).first()
        if not category:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Category with id {category_id} not found"
            )
        return category

    @staticmethod
    def get_category_products(db: Session, category_id: int):
        category = CategoryService.get_by_id(db, category_id)
        # Find products matching this category name
        products = db.query(Product).filter(Product.category.ilike(category.name)).all()
        return products

    @staticmethod
    def create_category(db: Session, cat_data: CategoryCreate):
        existing = db.query(Category).filter(Category.name.ilike(cat_data.name)).first()
        if existing:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Category already exists"
            )
        new_cat = Category(name=cat_data.name, imageUrl=cat_data.imageUrl)
        db.add(new_cat)
        db.commit()
        db.refresh(new_cat)
        logger.info(f"Category created: id={new_cat.id}, name={new_cat.name}")
        return new_cat
