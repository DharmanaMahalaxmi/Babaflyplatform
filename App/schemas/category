from pydantic import BaseModel, Field
from typing import Optional

class CategoryBase(BaseModel):
    name: str = Field(..., min_length=2, max_length=100, example="Rings")
    imageUrl: Optional[str] = Field(None, example="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=500")

class CategoryCreate(CategoryBase):
    pass

class CategoryOut(CategoryBase):
    id: int

    class Config:
        from_attributes = True
