import { useState, useMemo, FormEvent } from 'react';
import { 
  ShieldCheck, 
  ShieldAlert, 
  Plus, 
  Trash2, 
  Edit3, 
  Package, 
  Users, 
  ShoppingBag, 
  Search, 
  Check, 
  X, 
  RefreshCw, 
  AlertTriangle,
  ArrowRight,
  ExternalLink,
  Lock,
  KeyRound
} from 'lucide-react';
import { Product, User, Category, Order } from '../types';
import { backendEngine } from '../backend/engine';

interface AdminPortalProps {
  currentUser: User | null;
  jwtToken: string | null;
  onLoginDemo: (role: 'admin' | 'user') => void;
  onOpenNewUserChecker: () => void;
  onSwitchToStorefront: () => void;
}

export function AdminPortal({
  currentUser,
  jwtToken,
  onLoginDemo,
  onOpenNewUserChecker,
  onSwitchToStorefront,
}: AdminPortalProps) {
  const isAdmin = currentUser?.role === 'admin';

  // Active Admin Sub Tab
  const [adminTab, setAdminTab] = useState<'catalog' | 'orders' | 'users'>('catalog');

  // Products state
  const [products, setProducts] = useState<Product[]>(backendEngine.getStorefrontProducts());
  const categories = backendEngine.getStorefrontCategories();
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategory, setSelectedCategory] = useState('All');

  // Orders state
  const [orders, setOrders] = useState<Order[]>(backendEngine.getStorefrontOrders());

  // Users state
  const [users, setUsers] = useState<User[]>(backendEngine.getStorefrontUsers());

  // Modals & Forms
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [editingProduct, setEditingProduct] = useState<Product | null>(null);
  const [adminActionFeedback, setAdminActionFeedback] = useState<{ type: 'success' | 'error'; message: string } | null>(null);

  // New product form
  const [newProductForm, setNewProductForm] = useState({
    name: '',
    category: 'Rings',
    price: 950,
    discount: 10,
    stock: 20,
    metalType: 'Gold',
    polishType: 'High Polish',
    description: '',
    imageUrl: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600',
  });

  const filteredProducts = useMemo(() => {
    return products.filter((p) => {
      if (selectedCategory !== 'All' && p.category !== selectedCategory) return false;
      if (searchQuery && !p.name.toLowerCase().includes(searchQuery.toLowerCase())) return false;
      return true;
    });
  }, [products, selectedCategory, searchQuery]);

  const refreshData = () => {
    setProducts(backendEngine.getStorefrontProducts());
    setOrders(backendEngine.getStorefrontOrders());
    setUsers(backendEngine.getStorefrontUsers());
  };

  // Handle Create Product
  const handleCreateProduct = async (e: FormEvent) => {
    e.preventDefault();
    if (!isAdmin || !jwtToken) {
      setAdminActionFeedback({ type: 'error', message: '403 Forbidden: Administrator role and valid JWT required.' });
      return;
    }

    try {
      const res = await backendEngine.handleRequest(
        'POST',
        '/api/products',
        {},
        {
          name: newProductForm.name,
          category: newProductForm.category,
          price: Number(newProductForm.price),
          discount: Number(newProductForm.discount),
          stock: Number(newProductForm.stock),
          metalType: newProductForm.metalType,
          polishType: newProductForm.polishType,
          description: newProductForm.description || `Exquisite handcrafted ${newProductForm.category.toLowerCase()}`,
          imageUrl: newProductForm.imageUrl,
        },
        `Bearer ${jwtToken}`
      );

      if (res.status === 201) {
        refreshData();
        setIsAddModalOpen(false);
        setAdminActionFeedback({ type: 'success', message: `Product "${newProductForm.name}" created successfully via POST /api/products.` });
        setNewProductForm({
          name: '',
          category: 'Rings',
          price: 950,
          discount: 10,
          stock: 20,
          metalType: 'Gold',
          polishType: 'High Polish',
          description: '',
          imageUrl: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600',
        });
      } else {
        setAdminActionFeedback({ type: 'error', message: res.data?.detail || 'Failed to create product' });
      }
    } catch (err: any) {
      setAdminActionFeedback({ type: 'error', message: err.message });
    }
  };

  // Handle Edit Product
  const handleUpdateProduct = async (e: FormEvent) => {
    e.preventDefault();
    if (!editingProduct || !isAdmin || !jwtToken) return;

    try {
      const res = await backendEngine.handleRequest(
        'PUT',
        `/api/products/${editingProduct.id}`,
        {},
        editingProduct,
        `Bearer ${jwtToken}`
      );

      if (res.status === 200) {
        refreshData();
        setEditingProduct(null);
        setAdminActionFeedback({ type: 'success', message: `Product #${editingProduct.id} updated successfully via PUT /api/products/${editingProduct.id}.` });
      } else {
        setAdminActionFeedback({ type: 'error', message: res.data?.detail || 'Update failed' });
      }
    } catch (err: any) {
      setAdminActionFeedback({ type: 'error', message: err.message });
    }
  };

  // Handle Delete Product
  const handleDeleteProduct = async (id: number, name: string) => {
    if (!isAdmin || !jwtToken) {
      setAdminActionFeedback({ type: 'error', message: '403 Forbidden: Administrator role and valid JWT required.' });
      return;
    }

    try {
      const res = await backendEngine.handleRequest(
        'DELETE',
        `/api/products/${id}`,
        {},
        null,
        `Bearer ${jwtToken}`
      );

      if (res.status === 200) {
        refreshData();
        setAdminActionFeedback({ type: 'success', message: `Product "${name}" deleted via DELETE /api/products/${id}.` });
      } else {
        setAdminActionFeedback({ type: 'error', message: res.data?.detail || 'Deletion failed' });
      }
    } catch (err: any) {
      setAdminActionFeedback({ type: 'error', message: err.message });
    }
  };

  return (
    <div className="space-y-6">
      {/* Top Banner & RBAC Status */}
      <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 relative overflow-hidden">
        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div className="flex items-start gap-4">
            <div className="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0">
              <ShieldCheck className="w-6 h-6" />
            </div>
            <div>
              <div className="flex items-center gap-2 flex-wrap">
                <h2 className="text-xl font-bold text-white tracking-tight">Admin Management Console</h2>
                <span className="text-xs px-2.5 py-0.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 font-mono font-bold">
                  PORTAL / ADMIN
                </span>
                {isAdmin ? (
                  <span className="text-xs px-2 py-0.5 rounded-md bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-medium flex items-center gap-1">
                    <Check className="w-3 h-3" /> Authenticated as Administrator
                  </span>
                ) : (
                  <span className="text-xs px-2 py-0.5 rounded-md bg-rose-500/15 border border-rose-500/30 text-rose-400 font-medium flex items-center gap-1">
                    <Lock className="w-3 h-3" /> Restricted Access (User Role)
                  </span>
                )}
              </div>
              <p className="text-sm text-slate-400 mt-1 max-w-2xl">
                Dedicated management interface for product catalog CRUD operations, viewing platform-wide customer orders, and auditing registered user accounts with FastAPI RBAC controls.
              </p>
            </div>
          </div>

          {/* Quick Actions */}
          <div className="flex items-center flex-wrap gap-2">
            {!isAdmin ? (
              <button
                onClick={() => onLoginDemo('admin')}
                className="flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold px-4 py-2.5 rounded-xl shadow-md transition-all cursor-pointer text-xs"
              >
                <KeyRound className="w-4 h-4" />
                <span>Switch to Admin JWT</span>
              </button>
            ) : (
              <button
                onClick={() => setIsAddModalOpen(true)}
                className="flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2.5 rounded-xl shadow-md transition-all cursor-pointer text-xs"
              >
                <Plus className="w-4 h-4 stroke-[3]" />
                <span>Add New Product (POST /api/products)</span>
              </button>
            )}

            <button
              onClick={onOpenNewUserChecker}
              className="flex items-center gap-1.5 bg-blue-600/20 hover:bg-blue-600/30 text-blue-300 border border-blue-500/30 font-medium px-3.5 py-2.5 rounded-xl transition-all cursor-pointer text-xs"
            >
              <Users className="w-4 h-4" />
              <span>Check / Test New User</span>
            </button>

            <button
              onClick={onSwitchToStorefront}
              className="flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium px-3.5 py-2.5 rounded-xl border border-slate-700 transition-all cursor-pointer text-xs"
            >
              <ShoppingBag className="w-4 h-4" />
              <span>Go to User Storefront</span>
            </button>
          </div>
        </div>

        {/* Feedback alert */}
        {adminActionFeedback && (
          <div className={`mt-4 p-3 rounded-xl border text-xs flex items-center justify-between ${
            adminActionFeedback.type === 'success'
              ? 'bg-emerald-500/15 border-emerald-500/30 text-emerald-300'
              : 'bg-rose-500/15 border-rose-500/30 text-rose-300'
          }`}>
            <div className="flex items-center gap-2">
              {adminActionFeedback.type === 'success' ? <Check className="w-4 h-4" /> : <AlertTriangle className="w-4 h-4" />}
              <span>{adminActionFeedback.message}</span>
            </div>
            <button
              onClick={() => setAdminActionFeedback(null)}
              className="text-slate-400 hover:text-white ml-2"
            >
              <X className="w-3.5 h-3.5" />
            </button>
          </div>
        )}

        {/* Security Alert if not Admin */}
        {!isAdmin && (
          <div className="mt-4 p-4 rounded-xl border border-rose-500/30 bg-rose-500/10 text-rose-200 flex items-start gap-3 text-xs">
            <ShieldAlert className="w-5 h-5 text-rose-400 shrink-0 mt-0.5" />
            <div>
              <p className="font-bold text-rose-300">FastAPI Role-Based Access Control (RBAC) Active</p>
              <p className="mt-0.5 text-rose-200/80">
                You are currently browsing with a regular customer user token or unauthenticated session. Attempting to add, edit, or delete items will be rejected by the backend with <code className="font-mono text-amber-300">403 Forbidden: Admin role required</code>. Click <strong>"Switch to Admin JWT"</strong> above to gain full administrative write permissions.
              </p>
            </div>
          </div>
        )}
      </div>

      {/* Admin Sub Navigation */}
      <div className="flex border-b border-slate-800 bg-slate-900/60 rounded-t-xl px-4 pt-1 gap-2">
        <button
          onClick={() => setAdminTab('catalog')}
          className={`px-4 py-3 text-xs font-bold border-b-2 transition-all flex items-center gap-2 cursor-pointer ${
            adminTab === 'catalog'
              ? 'border-amber-400 text-amber-400'
              : 'border-transparent text-slate-400 hover:text-slate-200'
          }`}
        >
          <Package className="w-4 h-4" />
          <span>Product Catalog ({products.length})</span>
        </button>

        <button
          onClick={() => setAdminTab('orders')}
          className={`px-4 py-3 text-xs font-bold border-b-2 transition-all flex items-center gap-2 cursor-pointer ${
            adminTab === 'orders'
              ? 'border-amber-400 text-amber-400'
              : 'border-transparent text-slate-400 hover:text-slate-200'
          }`}
        >
          <ShoppingBag className="w-4 h-4" />
          <span>Platform Customer Orders ({orders.length})</span>
        </button>

        <button
          onClick={() => setAdminTab('users')}
          className={`px-4 py-3 text-xs font-bold border-b-2 transition-all flex items-center gap-2 cursor-pointer ${
            adminTab === 'users'
              ? 'border-amber-400 text-amber-400'
              : 'border-transparent text-slate-400 hover:text-slate-200'
          }`}
        >
          <Users className="w-4 h-4" />
          <span>Registered Users & Roles ({users.length})</span>
        </button>
      </div>

      {/* TAB 1: Product Catalog CRUD */}
      {adminTab === 'catalog' && (
        <div className="bg-slate-900 border border-slate-800 rounded-b-xl p-6 space-y-4">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div className="relative flex-1 max-w-md">
              <Search className="w-4 h-4 absolute left-3 top-3 text-slate-500" />
              <input
                type="text"
                placeholder="Search products by title..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="w-full bg-slate-950 border border-slate-800 rounded-xl pl-9 pr-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500"
              />
            </div>

            <div className="flex items-center gap-2">
              <select
                value={selectedCategory}
                onChange={(e) => setSelectedCategory(e.target.value)}
                className="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-300 focus:outline-none focus:border-amber-500"
              >
                <option value="All">All Categories</option>
                {categories.map((c) => (
                  <option key={c.id} value={c.name}>{c.name}</option>
                ))}
              </select>

              <button
                onClick={refreshData}
                title="Refresh products"
                className="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl transition-colors cursor-pointer"
              >
                <RefreshCw className="w-4 h-4" />
              </button>
            </div>
          </div>

          {/* Table */}
          <div className="overflow-x-auto border border-slate-800 rounded-xl">
            <table className="w-full text-left text-xs text-slate-300">
              <thead className="bg-slate-950 text-slate-400 font-semibold border-b border-slate-800 uppercase tracking-wider text-[10px]">
                <tr>
                  <th className="p-3">Product</th>
                  <th className="p-3">Category</th>
                  <th className="p-3">Price & Discount</th>
                  <th className="p-3">Specs (Metal / Polish)</th>
                  <th className="p-3">Stock</th>
                  <th className="p-3 text-right">Admin Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/60 bg-slate-900/40">
                {filteredProducts.map((prod) => (
                  <tr key={prod.id} className="hover:bg-slate-800/40 transition-colors">
                    <td className="p-3">
                      <div className="flex items-center gap-3">
                        <img
                          src={prod.imageUrl}
                          alt={prod.name}
                          className="w-10 h-10 rounded-lg object-cover bg-slate-950 border border-slate-800"
                          onError={(e) => {
                            (e.target as HTMLElement).style.display = 'none';
                          }}
                        />
                        <div>
                          <p className="font-bold text-white text-xs">{prod.name}</p>
                          <p className="text-[10px] text-slate-500 font-mono">ID: #{prod.id}</p>
                        </div>
                      </div>
                    </td>

                    <td className="p-3">
                      <span className="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 text-[10px] font-medium">
                        {prod.category}
                      </span>
                    </td>

                    <td className="p-3">
                      <div className="font-semibold text-amber-300">${prod.price.toFixed(2)}</div>
                      {prod.discount > 0 && (
                        <div className="text-[10px] text-emerald-400">-{prod.discount}% off</div>
                      )}
                    </td>

                    <td className="p-3">
                      <div className="text-slate-300 font-medium">{prod.metalType}</div>
                      <div className="text-[10px] text-slate-500">{prod.polishType}</div>
                    </td>

                    <td className="p-3">
                      <span className={`px-2 py-0.5 rounded font-mono text-[10px] font-bold ${
                        prod.stock > 10
                          ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                          : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                      }`}>
                        {prod.stock} units
                      </span>
                    </td>

                    <td className="p-3 text-right">
                      <div className="flex items-center justify-end gap-1.5">
                        <button
                          onClick={() => setEditingProduct(prod)}
                          title="Edit product"
                          className="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors cursor-pointer"
                        >
                          <Edit3 className="w-3.5 h-3.5" />
                        </button>
                        <button
                          onClick={() => handleDeleteProduct(prod.id, prod.name)}
                          title="Delete product"
                          className="p-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 transition-colors cursor-pointer"
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* TAB 2: All Platform Orders */}
      {adminTab === 'orders' && (
        <div className="bg-slate-900 border border-slate-800 rounded-b-xl p-6 space-y-4">
          <div className="flex items-center justify-between">
            <div>
              <h3 className="text-sm font-bold text-white">Platform Customer Orders ({orders.length})</h3>
              <p className="text-xs text-slate-400">
                Admins have permission to view all customer orders across all user accounts in the system.
              </p>
            </div>
            <button
              onClick={refreshData}
              className="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl transition-colors cursor-pointer text-xs flex items-center gap-1.5"
            >
              <RefreshCw className="w-3.5 h-3.5" />
              <span>Refresh Orders</span>
            </button>
          </div>

          <div className="divide-y divide-slate-800 border border-slate-800 rounded-xl overflow-hidden bg-slate-950">
            {orders.map((o) => (
              <div key={o.id} className="p-4 space-y-2.5">
                <div className="flex flex-wrap items-center justify-between gap-2">
                  <div className="flex items-center gap-2">
                    <span className="font-mono text-xs font-bold text-amber-400">Order #{o.id}</span>
                    <span className="text-[10px] px-2 py-0.5 rounded bg-blue-500/15 text-blue-300 border border-blue-500/30 font-mono">
                      Customer ID: #{o.userId}
                    </span>
                    <span className="text-[10px] px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-bold">
                      {o.paymentStatus}
                    </span>
                  </div>

                  <div className="text-xs font-semibold text-slate-300">
                    Total: <span className="text-amber-300 font-bold">${o.totalPrice.toFixed(2)}</span>
                  </div>
                </div>

                <div className="text-xs text-slate-400 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                  <span>Shipping Address: <strong className="text-slate-200">{o.address}</strong></span>
                  <span className="text-slate-500 font-mono text-[10px]">{new Date(o.createdAt).toLocaleString()}</span>
                </div>

                {/* Items in order */}
                <div className="bg-slate-900/80 p-2.5 rounded-lg border border-slate-800/80">
                  <span className="text-[10px] text-slate-500 uppercase font-mono block mb-1">Purchased Items:</span>
                  <div className="space-y-1">
                    {o.items.map((it, idx) => (
                      <div key={idx} className="flex items-center justify-between text-xs text-slate-300">
                        <span>{it.quantity}x {it.name}</span>
                        <span className="font-mono text-slate-400">${(it.price * it.quantity).toFixed(2)}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* TAB 3: Registered Users */}
      {adminTab === 'users' && (
        <div className="bg-slate-900 border border-slate-800 rounded-b-xl p-6 space-y-4">
          <div className="flex items-center justify-between">
            <div>
              <h3 className="text-sm font-bold text-white">Registered User Directory ({users.length})</h3>
              <p className="text-xs text-slate-400">
                Audited list of all user records, password hash protection status, and RBAC permission roles.
              </p>
            </div>
            <button
              onClick={onOpenNewUserChecker}
              className="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-3.5 py-2 rounded-xl transition-all shadow-sm cursor-pointer flex items-center gap-1.5"
            >
              <Plus className="w-3.5 h-3.5" />
              <span>Test & Register New User</span>
            </button>
          </div>

          <div className="divide-y divide-slate-800 border border-slate-800 rounded-xl overflow-hidden bg-slate-950">
            {users.map((u) => (
              <div key={u.id} className="p-4 flex items-center justify-between gap-3">
                <div>
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-bold text-white">{u.name}</span>
                    <span className={`text-[10px] uppercase font-bold px-2 py-0.5 rounded ${
                      u.role === 'admin' 
                        ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' 
                        : 'bg-blue-500/20 text-blue-300 border border-blue-500/30'
                    }`}>
                      {u.role}
                    </span>
                    <span className="text-[10px] font-mono text-slate-500">ID #{u.id}</span>
                  </div>
                  <p className="text-xs font-mono text-slate-400 mt-0.5">{u.email}</p>
                  <p className="text-[10px] text-slate-500 mt-0.5">Created: {new Date(u.created_at).toLocaleDateString()}</p>
                </div>

                <div className="flex items-center gap-2">
                  <span className="text-[10px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-md font-mono">
                    bcrypt salted
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Add Product Modal */}
      {isAddModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4 overflow-y-auto">
          <div className="w-full max-w-lg bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden">
            <div className="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950">
              <h4 className="text-sm font-bold text-white flex items-center gap-2">
                <Plus className="w-4 h-4 text-amber-400" />
                <span>Create New Product (POST /api/products)</span>
              </h4>
              <button
                onClick={() => setIsAddModalOpen(false)}
                className="text-slate-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <form onSubmit={handleCreateProduct} className="p-6 space-y-4">
              <div>
                <label className="text-xs text-slate-400 block mb-1">Product Title</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Royal Marquise Diamond Pendant"
                  value={newProductForm.name}
                  onChange={(e) => setNewProductForm({ ...newProductForm, name: e.target.value })}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Category</label>
                  <select
                    value={newProductForm.category}
                    onChange={(e) => setNewProductForm({ ...newProductForm, category: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  >
                    {categories.map((c) => (
                      <option key={c.id} value={c.name}>{c.name}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label className="text-xs text-slate-400 block mb-1">Price ($ USD)</label>
                  <input
                    type="number"
                    min="1"
                    step="0.01"
                    required
                    value={newProductForm.price}
                    onChange={(e) => setNewProductForm({ ...newProductForm, price: parseFloat(e.target.value) || 0 })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Metal Type</label>
                  <select
                    value={newProductForm.metalType}
                    onChange={(e) => setNewProductForm({ ...newProductForm, metalType: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  >
                    <option value="Gold">Gold</option>
                    <option value="Platinum">Platinum</option>
                    <option value="Rose Gold">Rose Gold</option>
                    <option value="Silver">Silver</option>
                    <option value="Diamond">Diamond</option>
                  </select>
                </div>

                <div>
                  <label className="text-xs text-slate-400 block mb-1">Polish Finish</label>
                  <select
                    value={newProductForm.polishType}
                    onChange={(e) => setNewProductForm({ ...newProductForm, polishType: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  >
                    <option value="High Polish">High Polish</option>
                    <option value="Matte">Matte</option>
                    <option value="Satin">Satin</option>
                    <option value="Brushed">Brushed</option>
                  </select>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Stock Units</label>
                  <input
                    type="number"
                    min="1"
                    value={newProductForm.stock}
                    onChange={(e) => setNewProductForm({ ...newProductForm, stock: parseInt(e.target.value, 10) || 0 })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  />
                </div>

                <div>
                  <label className="text-xs text-slate-400 block mb-1">Discount %</label>
                  <input
                    type="number"
                    min="0"
                    max="90"
                    value={newProductForm.discount}
                    onChange={(e) => setNewProductForm({ ...newProductForm, discount: parseInt(e.target.value, 10) || 0 })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  />
                </div>
              </div>

              <div>
                <label className="text-xs text-slate-400 block mb-1">Image URL</label>
                <input
                  type="url"
                  value={newProductForm.imageUrl}
                  onChange={(e) => setNewProductForm({ ...newProductForm, imageUrl: e.target.value })}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div className="flex items-center justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setIsAddModalOpen(false)}
                  className="px-4 py-2 rounded-xl text-xs text-slate-400 hover:text-white"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-5 py-2 rounded-xl text-xs transition-all cursor-pointer shadow-md"
                >
                  Create Product
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Edit Product Modal */}
      {editingProduct && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4 overflow-y-auto">
          <div className="w-full max-w-lg bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden">
            <div className="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950">
              <h4 className="text-sm font-bold text-white flex items-center gap-2">
                <Edit3 className="w-4 h-4 text-amber-400" />
                <span>Edit Product #{editingProduct.id} (PUT /api/products/{editingProduct.id})</span>
              </h4>
              <button
                onClick={() => setEditingProduct(null)}
                className="text-slate-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <form onSubmit={handleUpdateProduct} className="p-6 space-y-4">
              <div>
                <label className="text-xs text-slate-400 block mb-1">Title</label>
                <input
                  type="text"
                  required
                  value={editingProduct.name}
                  onChange={(e) => setEditingProduct({ ...editingProduct, name: e.target.value })}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Price ($ USD)</label>
                  <input
                    type="number"
                    min="1"
                    step="0.01"
                    required
                    value={editingProduct.price}
                    onChange={(e) => setEditingProduct({ ...editingProduct, price: parseFloat(e.target.value) || 0 })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  />
                </div>

                <div>
                  <label className="text-xs text-slate-400 block mb-1">Discount %</label>
                  <input
                    type="number"
                    min="0"
                    max="90"
                    value={editingProduct.discount}
                    onChange={(e) => setEditingProduct({ ...editingProduct, discount: parseInt(e.target.value, 10) || 0 })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-xs text-slate-400 block mb-1">Stock Units</label>
                  <input
                    type="number"
                    min="0"
                    value={editingProduct.stock}
                    onChange={(e) => setEditingProduct({ ...editingProduct, stock: parseInt(e.target.value, 10) || 0 })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  />
                </div>

                <div>
                  <label className="text-xs text-slate-400 block mb-1">Polish Finish</label>
                  <input
                    type="text"
                    value={editingProduct.polishType}
                    onChange={(e) => setEditingProduct({ ...editingProduct, polishType: e.target.value })}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-amber-500"
                  />
                </div>
              </div>

              <div className="flex items-center justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setEditingProduct(null)}
                  className="px-4 py-2 rounded-xl text-xs text-slate-400 hover:text-white"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-5 py-2 rounded-xl text-xs transition-all cursor-pointer shadow-md"
                >
                  Update Product
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
