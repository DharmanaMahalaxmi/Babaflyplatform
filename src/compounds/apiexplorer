import { useState, useEffect } from 'react';
import { Send, Copy, Check, Download, AlertTriangle, ShieldCheck, RefreshCw, Key, Filter, Layers } from 'lucide-react';
import { ApiEndpoint, User } from '../types';
import { backendEngine } from '../backend/engine';
import { generatePostmanCollection } from '../backend/postmanCollection';

interface ApiExplorerProps {
  currentUser: User | null;
  jwtToken: string | null;
  onSetJwtToken: (token: string | null, user: User | null) => void;
}

const ENDPOINTS: ApiEndpoint[] = [
  // User Module
  {
    id: 'user-register',
    method: 'POST',
    path: '/api/users/register',
    module: 'Users',
    title: 'Register New User',
    description: 'Registers user with unique email validation and bcrypt salted password hashing.',
    authRequired: false,
    defaultBody: {
      name: 'Rohan Verma',
      email: 'rohan.verma@example.com',
      password: 'SecurePassword123!',
      role: 'user',
    },
  },
  {
    id: 'user-login',
    method: 'POST',
    path: '/api/users/login',
    module: 'Users',
    title: 'Login & Obtain JWT Token',
    description: 'Authenticates credentials and generates signed JWT access token.',
    authRequired: false,
    defaultBody: {
      email: 'user@babafly.com',
      password: 'User@12345',
    },
  },
  {
    id: 'user-profile',
    method: 'GET',
    path: '/api/users/profile',
    module: 'Users',
    title: 'Get User Profile',
    description: 'Protected profile lookup requiring valid Bearer JWT authorization.',
    authRequired: true,
  },

  // Product Module
  {
    id: 'products-list',
    method: 'GET',
    path: '/api/products',
    module: 'Products',
    title: 'Get Products (Filter & Sort)',
    description: 'List products with filters (price_min, price_max, metal, polish), sorting, and pagination.',
    authRequired: false,
    defaultQueryParams: {
      metal: 'Gold',
      polish: 'High Polish',
      sort: 'price_high',
      page: '1',
      limit: '10',
      price_min: '100',
      price_max: '2000',
    },
  },
  {
    id: 'product-get-id',
    method: 'GET',
    path: '/api/products/1',
    module: 'Products',
    title: 'Get Product by ID',
    description: 'Fetch single jewelry product by primary key.',
    authRequired: false,
  },
  {
    id: 'product-create',
    method: 'POST',
    path: '/api/products',
    module: 'Products',
    title: 'Create Product (Admin Only)',
    description: 'Protected by Role-Based Access Control. Requires Admin JWT.',
    authRequired: true,
    adminOnly: true,
    defaultBody: {
      name: 'Royal Heritage Kundan Choker',
      description: 'Handcrafted 22K gold choker with uncut polki gemstones and pearl drops.',
      category: 'Necklaces',
      price: 1650.0,
      discount: 10.0,
      stock: 8,
      rating: 4.9,
      metalType: 'Gold',
      polishType: 'High Polish',
      imageUrl: 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=600',
    },
  },
  {
    id: 'product-update',
    method: 'PUT',
    path: '/api/products/1',
    module: 'Products',
    title: 'Update Product (Admin Only)',
    description: 'Modifies fields of an existing product in the catalog. Requires Admin JWT.',
    authRequired: true,
    adminOnly: true,
    defaultBody: {
      price: 1199.0,
      discount: 15.0,
      stock: 22,
    },
  },
  {
    id: 'product-delete',
    method: 'DELETE',
    path: '/api/products/6',
    module: 'Products',
    title: 'Delete Product (Admin Only)',
    description: 'Deletes product from catalog. Requires Admin JWT.',
    authRequired: true,
    adminOnly: true,
  },

  // Category Module
  {
    id: 'categories-list',
    method: 'GET',
    path: '/api/categories',
    module: 'Categories',
    title: 'Get All Categories',
    description: 'Retrieves all available jewelry and product categories.',
    authRequired: false,
  },
  {
    id: 'category-products',
    method: 'GET',
    path: '/api/categories/1/products',
    module: 'Categories',
    title: 'Get Products by Category ID',
    description: 'Fetches products matching category id (e.g., category 1: Rings).',
    authRequired: false,
  },

  // Order Module
  {
    id: 'order-create',
    method: 'POST',
    path: '/api/orders',
    module: 'Orders',
    title: 'Create Order (JWT Required)',
    description: 'Places a customer order. Requires authenticated user JWT.',
    authRequired: true,
    defaultBody: {
      items: [
        {
          productId: 1,
          name: 'Celestial Solitaire Diamond Ring',
          price: 1125.0,
          quantity: 1,
          imageUrl: 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600',
        },
      ],
      totalPrice: 1125.0,
      paymentStatus: 'PAID',
      address: '742 Evergreen Terrace, Springfield',
    },
  },
  {
    id: 'orders-user-list',
    method: 'GET',
    path: '/api/orders',
    module: 'Orders',
    title: "Get User's Orders (JWT Required)",
    description: 'Retrieves order history for current user (or all platform orders if admin).',
    authRequired: true,
  },
  {
    id: 'order-get-id',
    method: 'GET',
    path: '/api/orders/101',
    module: 'Orders',
    title: 'Get Order by ID (JWT Required)',
    description: 'Fetches order details by primary key with user ownership verification.',
    authRequired: true,
  },
];

export function ApiExplorer({ currentUser, jwtToken, onSetJwtToken }: ApiExplorerProps) {
  const [selectedEndpoint, setSelectedEndpoint] = useState<ApiEndpoint>(ENDPOINTS[3]); // default to products list
  const [method, setMethod] = useState<string>(selectedEndpoint.method);
  const [path, setPath] = useState<string>(selectedEndpoint.path);
  const [queryParams, setQueryParams] = useState<Record<string, string>>(
    selectedEndpoint.defaultQueryParams || {}
  );
  const [requestBody, setRequestBody] = useState<string>(
    selectedEndpoint.defaultBody ? JSON.stringify(selectedEndpoint.defaultBody, null, 2) : ''
  );
  const [includeAuthHeader, setIncludeAuthHeader] = useState<boolean>(selectedEndpoint.authRequired);
  const [customToken, setCustomToken] = useState<string>(jwtToken || '');

  // Response state
  const [loading, setLoading] = useState<boolean>(false);
  const [responseStatus, setResponseStatus] = useState<number | null>(null);
  const [responseData, setResponseData] = useState<any>(null);
  const [responseHeaders, setResponseHeaders] = useState<Record<string, string>>({});
  const [copied, setCopied] = useState<boolean>(false);
  const [selectedModule, setSelectedModule] = useState<string>('All');

  // Keep custom token synced with current JWT
  useEffect(() => {
    if (jwtToken) {
      setCustomToken(jwtToken);
    }
  }, [jwtToken]);

  // When selected endpoint changes
  const handleSelectEndpoint = (ep: ApiEndpoint) => {
    setSelectedEndpoint(ep);
    setMethod(ep.method);
    setPath(ep.path);
    setQueryParams(ep.defaultQueryParams || {});
    setRequestBody(ep.defaultBody ? JSON.stringify(ep.defaultBody, null, 2) : '');
    setIncludeAuthHeader(ep.authRequired);
  };

  const handleSendRequest = async () => {
    setLoading(true);
    try {
      let parsedBody = null;
      if (['POST', 'PUT'].includes(method) && requestBody.trim()) {
        try {
          parsedBody = JSON.parse(requestBody);
        } catch {
          setResponseStatus(400);
          setResponseData({ detail: 'Invalid JSON body syntax' });
          setResponseHeaders({ 'content-type': 'application/json' });
          setLoading(false);
          return;
        }
      }

      const auth = includeAuthHeader && customToken ? `Bearer ${customToken}` : undefined;
      const res = await backendEngine.handleRequest(method, path, queryParams, parsedBody, auth);

      setResponseStatus(res.status);
      setResponseData(res.data);
      setResponseHeaders(res.headers);

      // If this was a successful login, auto-update the JWT session!
      if (selectedEndpoint.id === 'user-login' && res.status === 200 && res.data?.access_token) {
        onSetJwtToken(res.data.access_token, res.data.user);
        setCustomToken(res.data.access_token);
      }
    } catch (err: any) {
      setResponseStatus(500);
      setResponseData({ detail: err.message || 'Network error' });
    } finally {
      setLoading(false);
    }
  };

  // Run automatically on first load so user immediately sees a live 200 response
  useEffect(() => {
    handleSendRequest();
  }, [selectedEndpoint.id]);

  const handleCopyJson = () => {
    if (!responseData) return;
    navigator.clipboard.writeText(JSON.stringify(responseData, null, 2));
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const handleExportPostman = () => {
    const baseUrl = window.location.origin;
    const collection = generatePostmanCollection(baseUrl);
    const blob = new Blob([JSON.stringify(collection, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'BabaFly_FastAPI_Postman_Collection.json';
    a.click();
    URL.revokeObjectURL(url);
  };

  const modules = ['All', 'Users', 'Products', 'Categories', 'Orders'];
  const filteredEndpoints =
    selectedModule === 'All'
      ? ENDPOINTS
      : ENDPOINTS.filter((e) => e.module === selectedModule);

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      {/* Top Banner & Postman Export */}
      <div className="mb-6 flex flex-wrap items-center justify-between gap-4 bg-slate-900/60 border border-slate-800 p-4 rounded-xl backdrop-blur-sm">
        <div>
          <div className="flex items-center gap-2">
            <h2 className="text-xl font-bold text-white tracking-tight">Interactive API Studio & Postman Runner</h2>
            <span className="text-xs bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2 py-0.5 rounded-full font-mono">
              Live Mock & Uvicorn Schema
            </span>
          </div>
          <p className="text-sm text-slate-400 mt-1">
            Execute all 13 required endpoints live. Perfect for testing authentication, query filtering, and recording your internship video.
          </p>
        </div>

        <div className="flex items-center gap-3">
          <button
            onClick={handleExportPostman}
            className="flex items-center gap-2 bg-orange-600 hover:bg-orange-500 text-white text-xs font-semibold px-3.5 py-2 rounded-lg transition-all shadow-sm cursor-pointer"
          >
            <Download className="w-4 h-4" />
            <span>Export Postman Collection (.JSON)</span>
          </button>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Left Sidebar: Endpoints list */}
        <div className="lg:col-span-4 space-y-4">
          {/* Module Filter Pills */}
          <div className="flex flex-wrap gap-1.5 p-1 bg-slate-900 border border-slate-800 rounded-lg">
            {modules.map((m) => (
              <button
                key={m}
                onClick={() => setSelectedModule(m)}
                className={`px-3 py-1 rounded text-xs font-medium transition-all cursor-pointer ${
                  selectedModule === m
                    ? 'bg-amber-500 text-slate-950 font-semibold shadow-sm'
                    : 'text-slate-400 hover:text-slate-200'
                }`}
              >
                {m}
              </button>
            ))}
          </div>

          {/* Endpoints List */}
          <div className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden divide-y divide-slate-800/60 max-h-[680px] overflow-y-auto">
            {filteredEndpoints.map((ep) => {
              const isSelected = selectedEndpoint.id === ep.id;
              const methodColor =
                ep.method === 'GET'
                  ? 'bg-blue-500/10 text-blue-400 border-blue-500/30'
                  : ep.method === 'POST'
                  ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                  : ep.method === 'PUT'
                  ? 'bg-amber-500/10 text-amber-400 border-amber-500/30'
                  : 'bg-rose-500/10 text-rose-400 border-rose-500/30';

              return (
                <button
                  key={ep.id}
                  onClick={() => handleSelectEndpoint(ep)}
                  className={`w-full text-left p-3.5 transition-all flex items-start gap-3 cursor-pointer ${
                    isSelected
                      ? 'bg-slate-800/80 border-l-4 border-l-amber-500'
                      : 'hover:bg-slate-800/40'
                  }`}
                >
                  <span className={`text-[10px] font-mono font-bold px-2 py-0.5 rounded border uppercase shrink-0 mt-0.5 ${methodColor}`}>
                    {ep.method}
                  </span>
                  <div className="min-w-0 flex-1">
                    <div className="flex items-center justify-between gap-1">
                      <p className="text-xs font-semibold text-slate-200 truncate">{ep.title}</p>
                      {ep.authRequired && (
                        <span title={ep.adminOnly ? 'Admin Role Required' : 'JWT Required'}>
                          <ShieldCheck className={`w-3.5 h-3.5 shrink-0 ${ep.adminOnly ? 'text-amber-400' : 'text-blue-400'}`} />
                        </span>
                      )}
                    </div>
                    <p className="text-[11px] font-mono text-slate-400 truncate mt-0.5">{ep.path}</p>
                  </div>
                </button>
              );
            })}
          </div>
        </div>

        {/* Right Pane: Request & Response Playground */}
        <div className="lg:col-span-8 space-y-5">
          {/* Active Endpoint Card */}
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-sm">
            <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
              <div>
                <h3 className="text-base font-bold text-white flex items-center gap-2">
                  <span>{selectedEndpoint.title}</span>
                  {selectedEndpoint.adminOnly && (
                    <span className="text-[10px] bg-amber-500/15 border border-amber-500/30 text-amber-300 px-2 py-0.5 rounded-full uppercase tracking-wider font-semibold">
                      Admin Role Only
                    </span>
                  )}
                  {selectedEndpoint.authRequired && !selectedEndpoint.adminOnly && (
                    <span className="text-[10px] bg-blue-500/15 border border-blue-500/30 text-blue-300 px-2 py-0.5 rounded-full uppercase tracking-wider font-semibold">
                      JWT Auth Required
                    </span>
                  )}
                </h3>
                <p className="text-xs text-slate-400 mt-1">{selectedEndpoint.description}</p>
              </div>

              <div className="flex items-center gap-2">
                <button
                  onClick={handleSendRequest}
                  disabled={loading}
                  className="flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold px-4 py-2 rounded-lg text-xs shadow-md transition-all cursor-pointer disabled:opacity-50"
                >
                  {loading ? (
                    <RefreshCw className="w-3.5 h-3.5 animate-spin" />
                  ) : (
                    <Send className="w-3.5 h-3.5" />
                  )}
                  <span>Send Request</span>
                </button>
              </div>
            </div>

            {/* Request URL Bar */}
            <div className="flex items-center bg-slate-950 border border-slate-800 rounded-lg p-1 font-mono text-xs">
              <span className={`px-2.5 py-1 rounded font-bold uppercase ${
                method === 'GET'
                  ? 'bg-blue-500/20 text-blue-400'
                  : method === 'POST'
                  ? 'bg-emerald-500/20 text-emerald-400'
                  : method === 'PUT'
                  ? 'bg-amber-500/20 text-amber-400'
                  : 'bg-rose-500/20 text-rose-400'
              }`}>
                {method}
              </span>
              <span className="px-3 text-slate-200 flex-1 truncate">{path}</span>
            </div>

            {/* Query Parameters (if applicable) */}
            {Object.keys(queryParams).length > 0 && (
              <div className="mt-4 pt-4 border-t border-slate-800/80">
                <h4 className="text-xs font-semibold text-slate-300 flex items-center gap-1.5 mb-2">
                  <Filter className="w-3.5 h-3.5 text-amber-400" />
                  <span>Query Parameters (Filtering, Sorting & Pagination)</span>
                </h4>
                <div className="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                  {Object.entries(queryParams).map(([key, val]) => (
                    <div key={key} className="bg-slate-950 border border-slate-800 rounded-lg p-2">
                      <label className="text-[10px] font-mono text-slate-400 block uppercase">{key}</label>
                      <input
                        type="text"
                        value={val}
                        onChange={(e) => setQueryParams({ ...queryParams, [key]: e.target.value })}
                        className="w-full bg-transparent text-xs text-amber-300 font-mono mt-0.5 focus:outline-none border-b border-transparent focus:border-amber-400/50"
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Headers & Auth Bar */}
            <div className="mt-4 pt-4 border-t border-slate-800/80">
              <div className="flex items-center justify-between mb-2">
                <label className="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                  <Key className="w-3.5 h-3.5 text-blue-400" />
                  <span>Authorization Header</span>
                </label>
                <label className="flex items-center gap-1.5 text-xs text-slate-400 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={includeAuthHeader}
                    onChange={(e) => setIncludeAuthHeader(e.target.checked)}
                    className="rounded border-slate-700 text-amber-500 focus:ring-0"
                  />
                  <span>Attach Bearer Token</span>
                </label>
              </div>

              {includeAuthHeader && (
                <div className="bg-slate-950 border border-slate-800 rounded-lg p-2.5 flex items-center gap-2">
                  <span className="text-[11px] font-mono text-slate-400 shrink-0">Bearer</span>
                  <input
                    type="text"
                    value={customToken}
                    onChange={(e) => setCustomToken(e.target.value)}
                    placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    className="w-full bg-transparent text-xs text-slate-300 font-mono focus:outline-none placeholder-slate-600"
                  />
                </div>
              )}
            </div>

            {/* Request Body (for POST / PUT) */}
            {['POST', 'PUT'].includes(method) && (
              <div className="mt-4 pt-4 border-t border-slate-800/80">
                <label className="text-xs font-semibold text-slate-300 flex items-center gap-1.5 mb-2">
                  <Layers className="w-3.5 h-3.5 text-emerald-400" />
                  <span>JSON Request Body</span>
                </label>
                <textarea
                  rows={6}
                  value={requestBody}
                  onChange={(e) => setRequestBody(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs text-emerald-300 font-mono focus:outline-none focus:border-amber-500/50 resize-y"
                  placeholder="{}"
                />
              </div>
            )}
          </div>

          {/* Response Box */}
          <div className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-sm">
            <div className="px-5 py-3 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
              <div className="flex items-center gap-3">
                <span className="text-xs font-semibold text-slate-300 uppercase tracking-wider">Response</span>
                {responseStatus !== null && (
                  <span
                    className={`text-xs font-mono font-bold px-2.5 py-0.5 rounded-full border ${
                      responseStatus >= 200 && responseStatus < 300
                        ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30'
                        : responseStatus === 401 || responseStatus === 403
                        ? 'bg-amber-500/15 text-amber-400 border-amber-500/30'
                        : 'bg-rose-500/15 text-rose-400 border-rose-500/30'
                    }`}
                  >
                    {responseStatus} {responseStatus === 200 ? 'OK' : responseStatus === 201 ? 'Created' : responseStatus === 401 ? 'Unauthorized' : responseStatus === 403 ? 'Forbidden' : responseStatus === 404 ? 'Not Found' : 'Error'}
                  </span>
                )}
                {responseHeaders['x-process-time'] && (
                  <span className="text-[11px] font-mono text-slate-400">
                    ⏱ {responseHeaders['x-process-time']}
                  </span>
                )}
              </div>

              <div className="flex items-center gap-2">
                <button
                  onClick={handleCopyJson}
                  disabled={!responseData}
                  className="flex items-center gap-1.5 text-xs text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 px-2.5 py-1 rounded transition-all cursor-pointer disabled:opacity-40"
                >
                  {copied ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                  <span>{copied ? 'Copied' : 'Copy JSON'}</span>
                </button>
              </div>
            </div>

            <div className="p-4 bg-slate-950 font-mono text-xs overflow-x-auto max-h-96">
              {loading ? (
                <div className="py-12 flex flex-col items-center justify-center text-slate-500 gap-2">
                  <RefreshCw className="w-6 h-6 animate-spin text-amber-400" />
                  <span>Processing FastAPI request...</span>
                </div>
              ) : responseData ? (
                <pre className="text-slate-200 whitespace-pre-wrap break-words leading-relaxed">
                  {JSON.stringify(responseData, null, 2)}
                </pre>
              ) : (
                <div className="py-12 text-center text-slate-600">
                  Hit "Send Request" to execute endpoint.
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
