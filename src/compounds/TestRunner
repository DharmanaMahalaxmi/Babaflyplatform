              : 'text-slate-400 border-slate-800 hover:border-slate-700'
          }`}
        >
          <Code2 className="w-3.5 h-3.5" />
          <span>View tests/test_api.py Source</span>
        </button>
      </div>

      {activeTab === 'visual' ? (
        <div className="space-y-4">
          {/* Terminal CLI Header */}
          <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 font-mono text-xs text-slate-400 flex items-center justify-between">
            <div className="flex items-center gap-2">
              <Terminal className="w-4 h-4 text-emerald-400" />
              <span className="text-slate-200 font-bold">$ pytest -v tests/test_api.py</span>
            </div>
            <span className="text-emerald-400 font-bold">5 passed in 0.21s (100%)</span>
          </div>

          {/* Test Case Cards */}
          <div className="space-y-3">
            {testResults.map((test) => (
              <div
                key={test.id}
                className="bg-slate-900 border border-slate-800 rounded-xl p-4 transition-all"
              >
                <div className="flex items-start justify-between gap-3">
                  <div className="flex items-start gap-3">
                    <div className="mt-0.5">
                      {test.status === 'passed' ? (
                        <CheckCircle2 className="w-5 h-5 text-emerald-400" />
                      ) : test.status === 'running' ? (
                        <RefreshCw className="w-5 h-5 text-amber-400 animate-spin" />
                      ) : (
                        <XCircle className="w-5 h-5 text-rose-400" />
