  const [testResults, setTestResults] = useState<TestCaseResult[]>([
    {
      id: 'test_1',
      name: 'test_1_user_registration',
      category: 'User Module',
      description: 'Verifies user registration, bcrypt password hashing, and duplicate email rejection (HTTP 400).',
      status: 'passed',
      durationMs: 42,
      logs: [
        'POST /api/users/register with name="Sarah Jenkins", email="sarah.jenkins@test.com"',
        'ASSERT response.status_code == 201 -> PASSED',
        'ASSERT response.json()["email"] == "sarah.jenkins@test.com" -> PASSED',
        'ASSERT "hashed_password" not in response.json() -> PASSED (Data Sanitized)',
        'POST /api/users/register with duplicate email="sarah.jenkins@test.com"',
