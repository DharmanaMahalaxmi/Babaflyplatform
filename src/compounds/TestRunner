import { useState } from 'react';
import { Play, CheckCircle2, XCircle, RefreshCw, Terminal, Check, Copy, ShieldCheck, Code2 } from 'lucide-react';
import { backendEngine } from '../backend/engine';

interface TestCaseResult {
  id: string;
  name: string;
  category: string;
  description: string;
  status: 'idle' | 'running' | 'passed' | 'failed';
  durationMs: number;
  logs: string[];
