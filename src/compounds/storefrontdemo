import { useState, useMemo, useEffect } from 'react';
import { 
  ShoppingBag, 
  Star, 
  Filter, 
  Sparkles, 
  Check, 
  X, 
  ShieldAlert, 
  PackageCheck, 
  UserCheck, 
  UserPlus, 
  ArrowRight, 
  Clock, 
  MapPin, 
  Crown,
  Lock,
  ExternalLink,
  ChevronRight,
  ShieldCheck
} from 'lucide-react';
import { Product, User, Category, Order } from '../types';
import { backendEngine } from '../backend/engine';

interface StorefrontDemoProps {
  currentUser: User | null;
  jwtToken: string | null;
  onLoginDemo: (role: 'admin' | 'user') => void;
  onOpenAdminPortal: () => void;
  onOpenNewUserChecker: () => void;
}

export function StorefrontDemo({ 
  currentUser, 
  jwtToken, 
  onLoginDemo,
  onOpenAdminPortal,
  onOpenNewUserChecker,
}: StorefrontDemoProps) {
  const [products] = useState<Product[]>(backendEngine.getStorefrontProducts());
  const categories = backendEngine.getStorefrontCategories();

  // Active view: 'catalog' | 'my_orders' | 'profile'
  const [userView, setUserView] = useState<'catalog' | 'my_orders' | 'profile'>('catalog');

  // Filters
  const [selectedCategory, setSelectedCategory] = useState<string>('All');
  const [selectedMetal, setSelectedMetal] = useState<string>('All');
  const [selectedPolish, setSelectedPolish] = useState<string>('All');
  const [sortBy, setSortBy] = useState<string>('latest');
  const [priceMax, setPriceMax] = useState<number>(2500);

  // Cart & Order State
  const [cart, setCart] = useState<{ product: Product; quantity: number }[]>([]);
  const [isCartOpen, setIsCartOpen] = useState<boolean>(false);
  const [deliveryAddress, setDeliveryAddress] = useState<string>('Flat 402, Lotus Towers, Bangalore, India');
  const [orderSuccess, setOrderSuccess] = useState<any>(null);
  const [orderError, setOrderError] = useState<string | null>(null);

  // User orders state
  const [myOrders, setMyOrders] = useState<Order[]>([]);
  const [loadingOrders, setLoadingOrders] = useState(false);

  // Fetch orders for current user
  const fetchMyOrders = async () => {
    if (!currentUser || !jwtToken) return;
    setLoadingOrders(true);
    try {
      const res = await backendEngine.handleRequest('GET', '/api/orders', {}, null, `Bearer ${jwtToken}`);
      if (res.status === 200) {
        setMyOrders(res.data || []);
      }
    } catch (err) {
      console.error(err);
    } finally {
      setLoadingOrders(false);
    }
  };

  useEffect(() => {
    if (userView === 'my_orders') {
      fetchMyOrders();
    }
  }, [userView, currentUser, jwtToken]);

  // Filtered and Sorted products
  const filteredProducts = useMemo(() => {
    return products
      .filter((p) => {
        if (selectedCategory !== 'All' && p.category !== selectedCategory) return false;
        if (selectedMetal !== 'All' && !p.metalType.toLowerCase().includes(selectedMetal.toLowerCase())) return false;
        if (selectedPolish !== 'All' && !p.polishType.toLowerCase().includes(selectedPolish.toLowerCase())) return false;
        if (p.price > priceMax) return false;
        return true;
      })
      .sort((a, b) => {
        if (sortBy === 'price_low') return a.price - b.price;
        if (sortBy === 'price_high') return b.price - a.price;
        if (sortBy === 'rating') return b.rating - a.rating;
        if (sortBy === 'popularity') return b.discount - a.discount;
        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
      });
  }, [products, selectedCategory, selectedMetal, selectedPolish, sortBy, priceMax]);

  // Cart operations
  const addToCart = (product: Product) => {
    setCart((prev) => {
      const existing = prev.find((item) => item.product.id === product.id);
      if (existing) {
        return prev.map((item) =>
          item.product.id === product.id ? { ...item, quantity: item.quantity + 1 } : item
        );
      }
      return [...prev, { product, quantity: 1 }];
    });
    setIsCartOpen(true);
  };

  const removeFromCart = (productId: number) => {
    setCart((prev) => prev.filter((item) => item.product.id !== productId));
  };

  const cartTotal = useMemo(() => {
    return cart.reduce((acc, item) => {
      const discountedPrice = item.product.price * (1 - item.product.discount / 100);
      return acc + discountedPrice * item.quantity;
    }, 0);
  }, [cart]);

  // Place Order through backend engine API
  const handlePlaceOrder = async () => {
    if (!currentUser || !jwtToken) {
      setOrderError('Please sign in with a user JWT to place an order.');
      return;
    }

    if (cart.length === 0) return;

    setOrderError(null);
    const orderItems = cart.map((item) => ({
      productId: item.product.id,
      name: item.product.name,
      price: item.product.price,
      quantity: item.quantity,
      imageUrl: item.product.imageUrl,
    }));

    const res = await backendEngine.handleRequest(
      'POST',
      '/api/orders',
      {},
      {
        items: orderItems,
        totalPrice: parseFloat(cartTotal.toFixed(2)),
        address: deliveryAddress,
        paymentStatus: 'PAID',
      },
      `Bearer ${jwtToken}`
    );

    if (res.status === 201) {
      setOrderSuccess(res.data);
      setCart([]);
      fetchMyOrders();
    } else {
      setOrderError(res.data?.detail || 'Failed to place order.');
    }
  };

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
      {/* Top Banner with Separated Links Awareness */}
      <div className="bg-gradient-to-r from-slate-900 via-slate-900 to-blue-950/40 border border-slate-800 p-6 rounded-2xl relative overflow-hidden">
        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div>
            <div className="flex items-center gap-2 flex-wrap">
              <span className="text-xs uppercase tracking-widest text-blue-400 font-bold flex items-center gap-1.5">
                <ShoppingBag className="w-3.5 h-3.5" /> Customer & User Portal
              </span>
              <span className="text-[10px] px-2 py-0.5 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-300 font-mono font-bold">
                USER LINK
              </span>
              {currentUser && (
                <span className="text-xs px-2.5 py-0.5 rounded-md bg-slate-800 border border-slate-700 text-slate-300 font-medium">
                  Logged in as: <strong className="text-white">{currentUser.name}</strong> ({currentUser.role})
                </span>
              )}
            </div>
            <h2 className="text-2xl font-bold text-white tracking-tight mt-1.5">BabaFly High Jewelry Storefront</h2>
            <p className="text-xs text-slate-400 mt-1 max-w-xl">
              Explore gold, platinum, and diamonds with real-time FastAPI queries, custom metal/finish filters, and isolated user cart checkout.
            </p>
          </div>

          {/* Quick Action Buttons */}
          <div className="flex items-center flex-wrap gap-2.5">
            {/* New User Check Button */}
            <button
              onClick={onOpenNewUserChecker}
              className="flex items-center gap-1.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-md transition-all cursor-pointer"
            >
              <UserPlus className="w-4 h-4" />
              <span>Check Once New User</span>
            </button>

            {/* Link to Admin Portal */}
            <button
              onClick={onOpenAdminPortal}
              className="flex items-center gap-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 font-semibold text-xs px-3.5 py-2.5 rounded-xl transition-all cursor-pointer"
            >
              <ShieldCheck className="w-4 h-4 text-amber-400" />
              <span>Go to Admin Link ➔</span>
            </button>

            {/* Shopping Bag Button */}
            <button
              onClick={() => setIsCartOpen(true)}
              className="relative flex items-center gap-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-all cursor-pointer"
            >
              <ShoppingBag className="w-4 h-4 text-amber-400" />
              <span>Bag ({cart.reduce((a, b) => a + b.quantity, 0)})</span>
              {cart.length > 0 && (
                <span className="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-amber-500 text-slate-950 font-bold text-[10px] flex items-center justify-center">
                  {cart.length}
                </span>
              )}
            </button>
          </div>
        </div>

        {/* User View Selector (Catalog vs My Orders vs Profile) */}
        <div className="flex items-center gap-2 mt-5 pt-4 border-t border-slate-800/80 text-xs">
          <button
            onClick={() => setUserView('catalog')}
            className={`px-3 py-1.5 rounded-lg font-semibold transition-all cursor-pointer ${
              userView === 'catalog'
                ? 'bg-blue-600 text-white shadow-sm'
                : 'bg-slate-800/60 text-slate-400 hover:text-white'
            }`}
          >
            Browse Jewelry Catalog
          </button>

          <button
            onClick={() => {
              setUserView('my_orders');
              fetchMyOrders();
            }}
            className={`px-3 py-1.5 rounded-lg font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${
              userView === 'my_orders'
                ? 'bg-blue-600 text-white shadow-sm'
                : 'bg-slate-800/60 text-slate-400 hover:text-white'
            }`}
          >
            <PackageCheck className="w-3.5 h-3.5" />
            <span>My Orders ({myOrders.length})</span>
          </button>

          <button
            onClick={() => setUserView('profile')}
            className={`px-3 py-1.5 rounded-lg font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${
              userView === 'profile'
                ? 'bg-blue-600 text-white shadow-sm'
                : 'bg-slate-800/60 text-slate-400 hover:text-white'
            }`}
          >
            <UserCheck className="w-3.5 h-3.5" />
            <span>My Profile (GET /api/users/profile)</span>
          </button>
        </div>
      </div>

      {/* VIEW 1: MY ORDERS */}
      {userView === 'my_orders' && (
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
          <div className="flex items-center justify-between">
            <div>
              <h3 className="text-base font-bold text-white flex items-center gap-2">
                <PackageCheck className="w-5 h-5 text-blue-400" />
                <span>My Order History (Customer ID #{currentUser?.id || 'Guest'})</span>
              </h3>
              <p className="text-xs text-slate-400 mt-0.5">
                Fetched from <code className="text-amber-400 font-mono">GET /api/orders</code> with user authorization. Only orders placed by your account are displayed.
              </p>
            </div>

            <button
              onClick={fetchMyOrders}
              className="text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg text-slate-300 cursor-pointer"
            >
              Refresh
            </button>
          </div>

          {myOrders.length === 0 ? (
            <div className="p-8 text-center bg-slate-950 rounded-xl border border-slate-800/80 space-y-3">
              <ShoppingBag className="w-8 h-8 text-slate-600 mx-auto" />
              <p className="text-sm font-semibold text-slate-300">No orders placed yet for this user.</p>
              <p className="text-xs text-slate-500 max-w-md mx-auto">
                Select jewelry items from the catalog and checkout with your JWT token, or use the "Check Once New User" tool to test order generation automatically.
              </p>
              <button
                onClick={() => setUserView('catalog')}
                className="bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs px-4 py-2 rounded-xl cursor-pointer"
              >
                Browse Catalog Now
              </button>
            </div>
          ) : (
            <div className="space-y-3">
              {myOrders.map((o) => (
                <div key={o.id} className="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-3">
                  <div className="flex flex-wrap items-center justify-between gap-2">
                    <div className="flex items-center gap-2">
                      <span className="font-mono text-xs font-bold text-amber-400">Order #{o.id}</span>
                      <span className="text-[10px] px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-bold">
                        {o.paymentStatus}
                      </span>
                    </div>
                    <span className="text-xs text-amber-300 font-bold">${o.totalPrice.toFixed(2)} USD</span>
                  </div>

                  <div className="text-xs text-slate-400">
                    Delivery Address: <span className="text-slate-200">{o.address}</span>
                  </div>

                  <div className="bg-slate-900 p-2.5 rounded-lg border border-slate-800/60 divide-y divide-slate-800/60">
                    {o.items.map((it, idx) => (
                      <div key={idx} className="py-1.5 first:pt-0 last:pb-0 flex items-center justify-between text-xs text-slate-300">
                        <div className="flex items-center gap-2">
                          <img src={it.imageUrl} alt={it.name} className="w-8 h-8 rounded object-cover bg-slate-950" />
                          <span>{it.quantity}x {it.name}</span>
                        </div>
                        <span className="font-mono text-slate-400">${(it.price * it.quantity).toFixed(2)}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {/* VIEW 2: PROFILE */}
      {userView === 'profile' && (
        <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
          <div>
            <h3 className="text-base font-bold text-white flex items-center gap-2">
              <UserCheck className="w-5 h-5 text-blue-400" />
              <span>Current User Profile</span>
            </h3>
            <p className="text-xs text-slate-400 mt-0.5">
              Sanitized account response from <code className="text-amber-400 font-mono">GET /api/users/profile</code>. Notice the password hash is stripped for security.
            </p>
          </div>

          {currentUser ? (
            <div className="bg-slate-950 border border-slate-800 p-5 rounded-xl space-y-3">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                  <span className="text-slate-500 block">Full Name</span>
                  <span className="text-white font-bold text-sm">{currentUser.name}</span>
                </div>
                <div>
                  <span className="text-slate-500 block">Email Address</span>
                  <span className="text-white font-mono">{currentUser.email}</span>
                </div>
                <div>
                  <span className="text-slate-500 block">Assigned Role</span>
                  <span className={`inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-bold uppercase ${
                    currentUser.role === 'admin' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-blue-500/20 text-blue-300 border border-blue-500/30'
                  }`}>
                    {currentUser.role}
                  </span>
                </div>
                <div>
                  <span className="text-slate-500 block">Account ID</span>
                  <span className="text-slate-300 font-mono">#{currentUser.id}</span>
                </div>
              </div>

              <div className="pt-3 border-t border-slate-800 flex items-center justify-between">
                <span className="text-xs text-slate-400">Want to test a brand new account?</span>
                <button
                  onClick={onOpenNewUserChecker}
                  className="text-xs text-blue-400 hover:text-blue-300 underline font-semibold cursor-pointer"
                >
                  Register / Check New User ➔
                </button>
              </div>
            </div>
          ) : (
            <div className="p-4 bg-slate-950 rounded-xl text-xs text-slate-400">
              No authenticated user session. Click Quick Auth in the top bar to sign in.
            </div>
          )}
        </div>
      )}

      {/* VIEW 3: CATALOG & SHOPPING */}
      {userView === 'catalog' && (
        <>
          {/* Filter & Sort Toolbar */}
          <div className="bg-slate-900 border border-slate-800 p-4 rounded-xl flex flex-wrap items-center justify-between gap-4">
            {/* Metal Filters */}
            <div className="flex items-center gap-2">
              <span className="text-xs font-semibold text-slate-400 flex items-center gap-1">
                <Filter className="w-3.5 h-3.5 text-amber-400" /> Metal:
              </span>
              {['All', 'Gold', 'Platinum', 'Silver', 'Rose Gold'].map((metal) => (
                <button
                  key={metal}
                  onClick={() => setSelectedMetal(metal)}
                  className={`text-xs px-2.5 py-1 rounded-lg border transition-all cursor-pointer ${
                    selectedMetal === metal
                      ? 'bg-amber-500/20 text-amber-300 border-amber-500/40 font-semibold'
                      : 'text-slate-400 border-slate-800 hover:border-slate-700'
                  }`}
                >
                  {metal}
                </button>
              ))}
            </div>

            {/* Polish Finish Filters */}
            <div className="flex items-center gap-2">
              <span className="text-xs font-semibold text-slate-400">Finish:</span>
              {['All', 'High Polish', 'Matte', 'Antique'].map((polish) => (
                <button
                  key={polish}
                  onClick={() => setSelectedPolish(polish)}
                  className={`text-xs px-2.5 py-1 rounded-lg border transition-all cursor-pointer ${
                    selectedPolish === polish
                      ? 'bg-blue-500/20 text-blue-300 border-blue-500/40 font-semibold'
                      : 'text-slate-400 border-slate-800 hover:border-slate-700'
                  }`}
                >
                  {polish}
                </button>
              ))}
            </div>

            {/* Categories */}
            <div className="flex items-center gap-2">
              <span className="text-xs font-semibold text-slate-400">Category:</span>
              <select
                value={selectedCategory}
                onChange={(e) => setSelectedCategory(e.target.value)}
                className="bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1 text-xs text-slate-300 focus:outline-none focus:border-amber-500"
              >
                <option value="All">All Categories</option>
                {categories.map((c) => (
                  <option key={c.id} value={c.name}>{c.name}</option>
                ))}
              </select>
            </div>

            {/* Sort */}
            <div className="flex items-center gap-2">
              <span className="text-xs font-semibold text-slate-400">Sort:</span>
              <select
                value={sortBy}
                onChange={(e) => setSortBy(e.target.value)}
                className="bg-slate-950 border border-slate-800 rounded-lg px-2.5 py-1 text-xs text-slate-300 focus:outline-none focus:border-amber-500"
              >
                <option value="latest">New Arrivals</option>
                <option value="price_low">Price: Low to High</option>
                <option value="price_high">Price: High to Low</option>
                <option value="rating">Top Rated</option>
                <option value="popularity">Biggest Discount</option>
              </select>
            </div>
          </div>

          {/* Product Grid */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            {filteredProducts.map((p) => {
              const discounted = p.price * (1 - p.discount / 100);
              return (
                <div
                  key={p.id}
                  className="bg-slate-900/90 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-all flex flex-col group"
                >
                  {/* Image & Badge */}
                  <div className="relative aspect-square bg-slate-950 overflow-hidden">
                    <img
                      src={p.imageUrl}
                      alt={p.name}
                      className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      onError={(e) => {
                        (e.target as HTMLElement).style.display = 'none';
                      }}
                    />
                    <div className="absolute top-2.5 left-2.5 flex flex-col gap-1">
                      {p.discount > 0 && (
                        <span className="bg-rose-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-md shadow-sm">
                          -{p.discount}%
                        </span>
                      )}
                      <span className="bg-slate-950/80 backdrop-blur-sm border border-slate-800 text-slate-300 text-[10px] font-medium px-2 py-0.5 rounded-md">
                        {p.metalType}
                      </span>
                    </div>

                    <div className="absolute top-2.5 right-2.5">
                      <span className="bg-slate-950/80 backdrop-blur-sm border border-slate-800 text-amber-300 text-[10px] font-semibold px-2 py-0.5 rounded-md flex items-center gap-1">
                        <Star className="w-3 h-3 fill-amber-400 text-amber-400" />
                        {p.rating}
                      </span>
                    </div>
                  </div>

                  {/* Body */}
                  <div className="p-4 flex-1 flex flex-col justify-between">
                    <div>
                      <div className="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">
                        {p.category} • {p.polishType}
                      </div>
                      <h4 className="text-sm font-bold text-white mt-1 line-clamp-1">{p.name}</h4>
                      <p className="text-xs text-slate-400 mt-1 line-clamp-2">{p.description}</p>
                    </div>

                    <div className="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between">
                      <div>
                        <div className="text-sm font-bold text-amber-300">${discounted.toFixed(2)}</div>
                        {p.discount > 0 && (
                          <div className="text-[10px] text-slate-500 line-through">${p.price.toFixed(2)}</div>
                        )}
                      </div>

                      <button
                        onClick={() => addToCart(p)}
                        className="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs px-3.5 py-1.5 rounded-xl transition-all shadow-sm cursor-pointer"
                      >
                        Add to Bag
                      </button>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </>
      )}

      {/* Cart Drawer */}
      {isCartOpen && (
        <div className="fixed inset-0 z-50 flex justify-end bg-black/60 backdrop-blur-sm">
          <div className="w-full max-w-md bg-slate-900 border-l border-slate-800 h-full p-6 flex flex-col justify-between shadow-2xl">
            <div>
              <div className="flex items-center justify-between pb-4 border-b border-slate-800">
                <h3 className="text-base font-bold text-white flex items-center gap-2">
                  <ShoppingBag className="w-5 h-5 text-amber-400" />
                  <span>Shopping Bag ({cart.reduce((a, b) => a + b.quantity, 0)})</span>
                </h3>
                <button
                  onClick={() => setIsCartOpen(false)}
                  className="text-slate-400 hover:text-white p-1 rounded-lg"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              {/* Cart Items */}
              <div className="mt-4 space-y-3 max-h-[45vh] overflow-y-auto pr-1">
                {cart.length === 0 ? (
                  <p className="text-xs text-slate-400 text-center py-8">Your bag is currently empty.</p>
                ) : (
                  cart.map((item) => {
                    const price = item.product.price * (1 - item.product.discount / 100);
                    return (
                      <div
                        key={item.product.id}
                        className="flex items-center justify-between p-3 bg-slate-950 rounded-xl border border-slate-800"
                      >
                        <div className="flex items-center gap-3">
                          <img
                            src={item.product.imageUrl}
                            alt={item.product.name}
                            className="w-12 h-12 rounded-lg object-cover bg-slate-900"
                          />
                          <div>
                            <h5 className="text-xs font-bold text-white line-clamp-1">{item.product.name}</h5>
                            <span className="text-[10px] text-slate-400">
                              Qty: {item.quantity} • ${price.toFixed(2)}
                            </span>
                          </div>
                        </div>

                        <button
                          onClick={() => removeFromCart(item.product.id)}
                          className="text-slate-500 hover:text-rose-400 text-xs p-1"
                        >
                          <X className="w-4 h-4" />
                        </button>
                      </div>
                    );
                  })
                )}
              </div>
            </div>

            {/* Checkout Section */}
            <div className="pt-4 border-t border-slate-800 space-y-3">
              <div>
                <label className="text-xs text-slate-400 block mb-1">Shipping Address (FastAPI Order Body)</label>
                <input
                  type="text"
                  value={deliveryAddress}
                  onChange={(e) => setDeliveryAddress(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-white focus:outline-none"
                />
              </div>

              <div className="flex items-center justify-between text-sm font-bold text-white">
                <span>Subtotal</span>
                <span className="text-amber-300 font-mono">${cartTotal.toFixed(2)} USD</span>
              </div>

              {orderError && (
                <div className="p-2.5 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs">
                  {orderError}
                </div>
              )}

              {orderSuccess && (
                <div className="p-3 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs space-y-1">
                  <div className="font-bold flex items-center gap-1.5">
                    <Check className="w-4 h-4" />
                    <span>Order #{orderSuccess.id} Confirmed!</span>
                  </div>
                  <p className="text-[11px] text-emerald-400/90">
                    Created in FastAPI backend via <code className="font-mono">POST /api/orders</code>.
                  </p>
                </div>
              )}

              <button
                onClick={handlePlaceOrder}
                disabled={cart.length === 0}
                className="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3 rounded-xl text-xs transition-all cursor-pointer shadow-md disabled:opacity-50"
              >
                Place Order (POST /api/orders)
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
