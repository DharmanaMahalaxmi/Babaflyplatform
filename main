# Include Module Routers
app.include_router(user_router, prefix=settings.API_PREFIX)
app.include_router(product_router, prefix=settings.API_PREFIX)
app.include_router(category_router, prefix=settings.API_PREFIX)
app.include_router(order_router, prefix=settings.API_PREFIX)

@app.get("/", summary="Root status endpoint")
def root():
    return {
        "status": "online",
        "platform": "BabaFly Platform Backend API",
        "framework": "FastAPI",
        "documentation": {
            "swagger_ui": "/docs",
            "redoc": "/redoc",
            "openapi": f"{settings.API_PREFIX}/openapi.json"
        },
        "version": settings.VERSION
    }

@app.get("/health", summary="Health check endpoint")
def health_check():
    return {"status": "healthy", "service": "babafly-backend"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=True)
